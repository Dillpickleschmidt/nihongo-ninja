{
  "name": "nihongo-ninja",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*",
      "scripts"
    ],
    "catalog": {
      "@convex-dev/react-query": "^0.1.0",
      "@react-native-async-storage/async-storage": "2.2.0",
      "@tanstack/react-query": "^5.90.8",
      "@tanstack/react-router": "^1.135.2",
      "@tanstack/react-start": "^1.135.2",
      "@types/node": "^26.0.0",
      "convex": "^1.38.0",
      "expo-router": "~6.0.13",
      "nativewind": "5.0.0-preview.4",
      "react-native": "~0.81.5",
      "react-native-css": "^3.0.1",
      "react-native-webview": "^13.15.0",
      "react-native-worklets": "~0.5.1",
      "tailwindcss": "^4.1.16",
      "typescript": "~6.0.3"
    },
    "catalogs": {
      "react19": {
        "@types/react": "~19.1.0",
        "@types/react-dom": "~19.1.0",
        "react": "19.1.4",
        "react-dom": "19.1.4"
      }
    }
  },
  "scripts": {
    "build": "nub run -r --if-present build",
    "clean": "git clean -xdf node_modules",
    "dev:tanstack-start": "nub run -F @nn/tanstack-start dev",
    "dev:expo": "nub run -F @nn/expo dev",
    "dev:electron": "nub run -F @nn/electron dev",
    "convex:dev": "nub run -F @nn/convex dev",
    "generate:routes": "nub scripts/generate-routes.ts",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "nub run -r --if-present typecheck",
    "android": "nub run -F @nn/expo android",
    "ios": "nub run -F @nn/expo ios"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "catalog:"
  },
  "overrides": {
    "lightningcss": "1.30.1",
    "vite": "7.1.12"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "nub@0.6.0",
  "allowBuilds": [
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
